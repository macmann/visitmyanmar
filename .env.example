DATABASE_URL="postgresql://postgres:postgres@localhost:5432/explore_myanmar"
DEV_TIMER_SCALE=1

# ==========================================
# GAME LLM (server-only; omit provider/key for authored fallback mode)
# ==========================================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# Provider credentials — never prefix these with NEXT_PUBLIC_
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional AI configuration
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=500
