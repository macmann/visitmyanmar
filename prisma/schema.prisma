generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String             @id
  userId    String?            @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  save      Json
  actions   PersistentAction[]
  progressionAwards ProgressionAward[]
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions  Session[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime @default(now())
  countryCode  String?
  player       Player?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  playerId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([expiresAt])
}

model PersistentAction {
  id          String    @id @default(cuid())
  playerId    String
  kind        String
  startedAt   DateTime
  completesAt DateTime
  payload     Json
  resolvedAt  DateTime?
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, completesAt])
}

model ProgressionAward {
  id         String   @id @default(cuid())
  playerId   String
  sourceType String
  sourceId   String
  xp         Int
  score      Int
  createdAt  DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, sourceType, sourceId])
  @@index([playerId, createdAt])
}
